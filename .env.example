# OpenAI
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE=0.0

# Retrieval
RETRIEVER_K=10
RERANK_TOP_K=4

# App
LOG_LEVEL="INFO"
# CORS: 운영에서는 도메인 화이트리스트 명시 (예: '["https://xdworld.example.com"]')
# 미설정 또는 "*" 포함 시 allow_credentials는 자동 비활성화됨
CORS_ORIGINS='["*"]'

# Database (ACTIVE_PROFILE 분기, PostgreSQL + pgvector)
DATABASE_URL_LOCAL="postgresql+asyncpg://xdworld:xdworld@localhost:5432/xdworld_agent"  # 로컬
# 운영 (prod): 5개 분리 환경변수 (K8s env/Secret 주입)
DB_HOST=""
DB_PORT=5432
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# Redis - 로컬 개발용 (ACTIVE_PROFILE=local 일 때 사용, URL 형식)
REDIS_HOST="redis://localhost:6379"

# Redis - 운영용 (K8s 클러스터, REDIS_HOST_1 설정 시 자동으로 클러스터 모드)
REDIS_HOST_1=""
REDIS_HOST_2=""
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD=""
