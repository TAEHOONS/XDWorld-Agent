OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE=0.0
RETRIEVER_K=4
LOG_LEVEL="INFO"
# CORS: 운영에서는 도메인 화이트리스트 명시 (예: '["https://xdworld.example.com"]')
# 미설정 또는 "*" 포함 시 allow_credentials는 자동 비활성화됨
CORS_ORIGINS='["*"]'

# Database (ACTIVE_PROFILE 분기)
# 로컬 (ACTIVE_PROFILE=local): docker-compose PG
DATABASE_URL_LOCAL="postgresql+asyncpg://xdworld:xdworld@localhost:5432/xdworld_agent"
# 운영 (ACTIVE_PROFILE=prod): 5개 환경변수 (K8s env 또는 Secret 주입)
DB_HOST=""
DB_PORT=5432
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# Redis - 로컬 (ACTIVE_PROFILE=local 일 때 사용, URL 형식)
REDIS_HOST="redis://localhost:6379"
